{
  "compilerOptions": {
    "target": "ES6",                    // ใช้ ES6 หรือสูงกว่า
    "module": "CommonJS",               // ใช้ CommonJS สำหรับ Node.js
    "strict": false,                    // ปิดใช้งานโหมด Strict เพื่อลด TypeScript errors
    "noImplicitAny": false,             // อนุญาตให้ใช้ any type โดยไม่ต้องประกาศ
    "esModuleInterop": true,            // การใช้งาน module แบบ ES และ CommonJS
    "skipLibCheck": true,               // ข้ามการตรวจสอบ types ของไลบรารี
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,     // เปิดใช้งาน decorators
    "emitDecoratorMetadata": true,      // เปิดใช้งาน metadata reflection
    "types": ["jest", "node"],
    "outDir": "./dist"           // เพิ่ม Jest types
  },
  "include": ["src/**/*","src/types/**/*.d.ts","test/**/*"],              // รวมไฟล์ทั้งหมดในโฟลเดอร์ src และ test
  "exclude": ["node_modules"]           // ไม่รวม node_modules
}





