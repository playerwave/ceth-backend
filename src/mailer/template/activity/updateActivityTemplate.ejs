<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Activity Update Notification</title>
  </head>
  <body style="margin: 0; padding: 20px; font-family: Arial, sans-serif; background-color: #f5f5f5;">
    
    <div style="
      width: 100%;
      max-width: 1300px;
      margin: 0 auto;
      padding: 24px 30px;
      border-radius: 12px;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
      background-color: #ffffff;
      font-family: Arial, sans-serif;
      border: 1px solid #ddd;
      box-sizing: border-box;
    ">
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 10px;">
        <h1 style="color: #3B82F6; margin: 0;">📢 <%= activityName || 'กิจกรรมอัปเดต' %></h1>
        <span style="
          background-color: #009730;
          color: white;
          padding: 4px 12px;
          border-radius: 20px;
          font-size: 12px;
          font-weight: bold;
          text-transform: uppercase;
        ">มีการแก้ไข</span>
      </div>
      
      <a href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=<%= encodeURIComponent(activityName || 'กิจกรรม') %>&dates=<%= activityDateISO || '20241220T090000Z' %>/<%= activityEndDateISO || '20241220T160000Z' %>&details=<%= encodeURIComponent(message || 'กิจกรรมมีการอัปเดต') %>&location=<%= encodeURIComponent((building || 'อาคารคณะวิทยาการสารสนเทศ') + ' ชั้น ' + (floor || '3') + ' ห้อง ' + (room || '301')) %>&sf=true&output=xml" 
         style="
           display: inline-block;
           background-color: #4285f4;
           color: white;
           padding: 8px 16px;
           text-decoration: none;
           border-radius: 4px;
           font-weight: 500;
           font-size: 14px;
           margin-bottom: 20px;
         "
         target="_blank">
        View on Google Calendar
      </a>

      <div style="margin-bottom: 20px;">
        <p style="margin-bottom: 4px;"><strong>ผู้จัด:</strong></p>
        <p style="margin-top: 0; color: #666;"><%= organizerName || 'คณะวิทยาการสารสนเทศ' %></p>
      </div>

      <div style="margin-bottom: 20px;">
        <p style="margin-bottom: 4px;"><strong>ประเภท:</strong></p>
        <p style="margin-top: 0; color: #666;"><%= activityType || 'Soft Skill' %> • ( + <%= hoursEarned || '3' %> ชั่วโมง )</p>
      </div>

      <div style="margin-bottom: 20px;">
        <p style="margin-bottom: 4px;"><strong>Description:</strong></p>
        <p style="margin-top: 0; color: #666;"><%= message || 'มีการเปลี่ยนแปลงในรายละเอียดกิจกรรม กรุณาตรวจสอบข้อมูลใหม่' %></p>
      </div>

      <div style="margin-bottom: 20px;"> 
        <p style="margin-bottom: 4px;"><strong>When:</strong></p>
        <p style="margin-top: 0; color: #666;"><%= activityDate || '20 ธันวาคม 2024' %> · <%= activityTime || '09:00-16:00' %> (เวลา ประเทศไทย)</p>
      </div>

      <div style="margin-bottom: 20px;"> 
        <p style="margin-bottom: 4px;"><strong>สถานที่:</strong></p>
        <p style="margin-top: 0; color: #666;"><%= building || 'อาคารคณะวิทยาการสารสนเทศ' %> ชั้น <%= floor || '3' %> ห้อง <%= room || '301' %></p>
      </div>

      <div style="margin-bottom: 20px;">
        <p style="margin-bottom: 4px;"><strong>จำนวนที่รับ:</strong></p>
        <p style="margin-top: 0; color: #666;"><%= maxParticipants || '50' %> คน</p>
      </div>

      <div style="margin-bottom: 20px;">
        <p style="margin-bottom: 4px;"><strong>ผู้จัด:</strong></p>
        <p style="margin-top: 0; color: #666;"><%= contactEmail || 'support@example.com' %></p>
      </div>
      
      <% if (activityImage) { %>
        <img src="<%= activityImage %>" alt="กิจกรรม" style="width:100%; margin: 15px 0; border-radius: 8px;" />
      <% } else { %>
        <img src="https://ichef.bbci.co.uk/ace/standard/976/cpsprodpb/F1F2/production/_118283916_b19c5a1f-162b-410b-8169-f58f0d153752.jpg" alt="กิจกรรม" style="width:100%; margin: 15px 0; border-radius: 8px;" />
      <% } %>

      <div style="text-align: center; margin: 30px 0;">
        <a href="<%= activityLink || '#' %>" style="
          display: inline-block;
          background-color: #1E3A8A;
          color: white;
          padding: 12px 24px;
          text-decoration: none;
          border-radius: 5px;
          font-weight: bold;
        ">
          📋 ดูรายละเอียดกิจกรรม
        </a>
      </div>

      <div style="text-align: center; margin-top: 30px; padding-top: 20px; border-top: 1px solid #eee; color: #666; font-size: 0.9em;">
        <p>หากมีคำถาม กรุณาติดต่อ: <%= contactEmail || 'support@example.com' %></p>
        <p>© 2024 ระบบจัดการกิจกรรม. สงวนลิขสิทธิ์.</p>
      </div>
    </div>
  </body>
</html>